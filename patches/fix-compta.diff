+	// fonction pour reformater les rubriques dans les cellules totaux en bas de rubriques agrégées
+	protected function reformatString($input) {
+		// Utiliser une expression régulière pour extraire les deux parties de la chaîne
+		if (preg_match('/^([IVXLCDMivxlcdm]+|\w+\d*)\) (.+)$/', $input, $matches)) {
+			$prefix = $matches[1];  // Capturer la partie avant la parenthèse
+			$mainPart = $matches[2];  // Capturer la partie après la parenthèse
+	
+			// Reconstruire la chaîne dans le nouveau format
+			//05-10-2024 tenir compte des cas  QUÊTES IMPEREES (a) et  AUTRES RECETTES (b) qui vont devenir QUÊTES IMPEREES (1) AUTRES RECETTES (2)
+			if($mainPart == 'QUÊTES IMPEREES'){
+				return $mainPart . ' (1)';
+			}elseif($mainPart == 'AUTRES RECETTES'){
+				return $mainPart . ' (2)';
+			}else{
+				return $mainPart . ' (' . $prefix . ')';
+			}
+			
+		} else {
+			// Si la chaîne ne correspond pas au format attendu, la retourner inchangée
+			return $input;
+		}
+	}
