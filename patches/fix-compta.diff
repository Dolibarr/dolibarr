+		//fonction de mise à jour du champ averserouarecevoir
+		function updateAverserourecevoirField(FieldValue, FieldOldValue){
+			FieldValue = parseFloat(FieldValue);
+			FieldOldValue = parseFloat(FieldOldValue);
+			if (!isNaN(FieldValue)){
+				var sens = $('#sens');
+				var averserourecevoirField = $('#averserourecevoir');
+				var libelleField = $("#label");
+				var labelforAverserourecevoirField = $('label[for="averserourecevoir"]');
