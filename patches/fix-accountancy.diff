+/**
+ * Return ref created
+ *
+ * @param 	string 	$datef			date of line submitted
+ * @return 	string					A string Ref
+ */
+function getRef($datef)
+{
+	global $langs;
+	//fred modif mettre la référence pcr-cr_ + date comme référence
+	$filename = strtolower(dol_sanitizeFileName($langs->transnoentities("recapitulatifventes")));
+	$filename = preg_replace('/\s/', '_', $filename);
+	$dateforfile = preg_replace('/[\s\/:]/', '_', dol_print_date($datef, 'day'));
+	$filenamedef = $filename.'_'.$dateforfile;
+	return $filenamedef;
+}
