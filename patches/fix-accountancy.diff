+	$in_bookkeeping = 'notyet';
+}
+
+$now = dol_now();
+
+$hookmanager->initHooks(array('purchasesjournal'));
+$parameters = array();
+
+// Security check
+if (!isModEnabled('accounting')) {
+	accessforbidden();
+}
