# SCCIT ERP SaaS - ملف الإعدادات البيئية

# إعدادات التطبيق
APP_NAME=SCCIT ERP SaaS
APP_ENV=production
APP_DEBUG=false
APP_PROTOCOL=https
APP_URL=https://saas.sccit-erp.com
MAIN_DOMAIN=saas.sccit-erp.com

# إعدادات قاعدة البيانات
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sccit_erp_saas
DB_USER=sccit_erp
DB_PASSWORD=your_secure_password_here

# إعدادات المصادقة
JWT_SECRET=your_jwt_secret_key_here
SESSION_TIMEOUT=3600

# إعدادات Stripe
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# إعدادات PayPal
PAYPAL_ENABLED=true
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# إعدادات البريد
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_FROM_ADDRESS=noreply@sccit-erp.com
MAIL_FROM_NAME="SCCIT ERP SaaS"
MAIL_ENCRYPTION=tls

# إعدادات AWS S3 (اختياري)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sccit-erp-saas

# إعدادات التخزين
STORAGE_DRIVER=local
MAX_FILE_SIZE=104857600

# إعدادات السجلات
LOG_LEVEL=info

# إعدادات النسخ الاحتياطية
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30

# إعدادات الأمان
HTTPS_ONLY=true
HSTS_ENABLED=true
CSRF_PROTECTION=true
RATE_LIMITING=true
