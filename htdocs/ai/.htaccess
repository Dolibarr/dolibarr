# Pass the HTTP Authorization header through to PHP.
#
# Apache with PHP-FPM or CGI drops it before PHP sees it, so the Bearer token
# an MCP client sends after a successful consent never arrives and every call
# answers 401 "Missing credentials". Reproduced on two unrelated shared hosts.
# These rules re-expose it as REDIRECT_HTTP_AUTHORIZATION / HTTP_AUTHORIZATION,
# which McpAuth::getCredential() already reads.
#
# Harmless where the header already arrives (mod_php, nginx, CGIPassAuth On).
# On a server that ignores .htaccess, the equivalent has to go in its own
# configuration: nginx passes it with
#   fastcgi_param HTTP_AUTHORIZATION $http_authorization;
<IfModule mod_rewrite.c>
	RewriteEngine On
	# Per-directory rewrite rules are not inherited: without this, turning the
	# engine on here would drop whatever a parent .htaccess does (an HTTPS
	# redirect, a host's own rules) for everything under /ai/.
	RewriteOptions InheritBefore
	RewriteCond %{HTTP:Authorization} .
	RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
<IfModule mod_setenvif.c>
	SetEnvIfNoCase Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>
